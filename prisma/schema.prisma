// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETION_PENDING
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETING
  DELETED
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

enum StudyPlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum StudyTaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum AIRequestFeature {
  TUTOR_CHAT
  DOCUMENT_QA
  QUIZ_GENERATION
  STUDY_PLAN_GENERATION
  OTHER
}

enum AIRequestStatus {
  SUCCESS
  FAILED
  RATE_LIMITED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(320)
  passwordHash    String     @db.VarChar(255)
  displayName     String?    @db.VarChar(100)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  conversations       Conversation[]
  documents           Document[]
  quizzes             Quiz[]
  quizAttempts        QuizAttempt[]
  studyPlans          StudyPlan[]
  aiUsages            AIUsage[]
  feedbacks           Feedback[]

  @@index([status, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  familyId  String    @db.Uuid
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String    @default("New conversation") @db.VarChar(200)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  content        String      @db.Text
  toolName       String?     @db.VarChar(100)
  modelId        String?     @db.VarChar(120)
  promptVersion  String?     @db.VarChar(60)
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedbacks    Feedback[]

  @@index([conversationId, createdAt])
}

model Document {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  originalName String         @db.VarChar(255)
  mimeType     String         @db.VarChar(100)
  sizeBytes    BigInt
  storageKey   String         @unique @db.VarChar(1000)
  status       DocumentStatus @default(UPLOADED)
  pageCount    Int?
  checksum     String?        @db.VarChar(128)
  errorCode    String?        @db.VarChar(100)
  processedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks  DocumentChunk[]
  quizzes Quiz[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model DocumentChunk {
  id             String                       @id @default(uuid()) @db.Uuid
  documentId     String                       @db.Uuid
  userId         String                       @db.Uuid
  chunkIndex     Int
  pageNumber     Int?
  text           String                       @db.Text
  embedding      Unsupported("vector(1536)")?
  embeddingModel String                       @db.VarChar(120)
  createdAt      DateTime                     @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([userId, documentId])
}

model Quiz {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  sourceDocumentId String?        @db.Uuid
  title            String         @db.VarChar(200)
  topic            String?        @db.VarChar(200)
  difficulty       QuizDifficulty @default(MEDIUM)
  questionCount    Int
  status           String         @default("READY") @db.VarChar(30)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocument Document?      @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  questions      QuizQuestion[]
  attempts       QuizAttempt[]

  @@index([userId, createdAt])
}

model QuizQuestion {
  id            String   @id @default(uuid()) @db.Uuid
  quizId        String   @db.Uuid
  orderIndex    Int
  prompt        String   @db.Text
  options       Json
  correctAnswer String   @db.VarChar(1000)
  explanation   String?  @db.Text
  createdAt     DateTime @default(now())

  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  responses QuizResponse[]

  @@unique([quizId, orderIndex])
}

model QuizAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  quizId         String        @db.Uuid
  userId         String        @db.Uuid
  status         AttemptStatus @default(IN_PROGRESS)
  score          Int?
  totalQuestions Int
  startedAt      DateTime      @default(now())
  submittedAt    DateTime?

  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses QuizResponse[]

  @@index([userId, startedAt])
}

model QuizResponse {
  id             String   @id @default(uuid()) @db.Uuid
  attemptId      String   @db.Uuid
  questionId     String   @db.Uuid
  selectedAnswer String?  @db.VarChar(1000)
  isCorrect      Boolean?
  answeredAt     DateTime @default(now())

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model StudyPlan {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  title        String          @db.VarChar(200)
  examDate     DateTime?
  timezone     String          @default("Asia/Kolkata") @db.VarChar(100)
  dailyMinutes Int
  preferences  Json?
  status       StudyPlanStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks StudyTask[]

  @@index([userId, status, updatedAt])
}

model StudyTask {
  id              String          @id @default(uuid()) @db.Uuid
  planId          String          @db.Uuid
  title           String          @db.VarChar(200)
  description     String?         @db.Text
  topic           String?         @db.VarChar(200)
  scheduledDate   DateTime
  durationMinutes Int
  status          StudyTaskStatus @default(TODO)
  orderIndex      Int             @default(0)
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  plan StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, scheduledDate])
}

model AIUsage {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  requestId     String           @unique @db.VarChar(100)
  feature       AIRequestFeature
  provider      String           @default("openai") @db.VarChar(80)
  modelId       String           @db.VarChar(120)
  status        AIRequestStatus  @default(SUCCESS)
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  estimatedCost Decimal?         @db.Decimal(12, 6)
  errorCode     String?          @db.VarChar(100)
  createdAt     DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  messageId String?  @db.Uuid
  rating    String   @db.VarChar(50)
  category  String?  @db.VarChar(100)
  comment   String   @db.Text
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([messageId])
}
