# ==============================================================================
# AI StudyMate - Staging Environment Configuration Template
# Populate in your staging CI/CD or staging PaaS secret manager.
# ==============================================================================

NODE_ENV=staging
PORT=5000

# Staging PostgreSQL instance with pgvector extension enabled
DATABASE_URL=postgresql://staging_user:staging_secure_password_replace@staging-db.internal:5432/studymate_staging?sslmode=require&connection_limit=20&pool_timeout=10

# Staging CORS origins
CORS_ORIGIN=https://staging-app.studymate.ai,https://staging-api.studymate.ai

# Trust reverse proxy (Cloudflare / ALB / Ingress)
TRUST_PROXY=true

# Logging
LOG_LEVEL=debug
REQUEST_BODY_LIMIT=10mb

# Strong staging JWT secret (at least 32 characters)
JWT_SECRET=staging-super-secret-jwt-key-minimum-32-characters-required
JWT_EXPIRES_IN=7d

# OpenAI Staging API credentials (use separate OpenAI project/key with spending limits)
OPENAI_API_KEY=sk-proj-staging-placeholder-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI Guardrails for Staging
AI_TUTOR_TEMPERATURE=0.7
AI_TUTOR_MAX_TOKENS=1024
AI_TUTOR_TIMEOUT_MS=30000
AI_TUTOR_MAX_RETRIES=2
AI_CONTEXT_MAX_MESSAGES=10

AI_DAILY_QUOTA_LIMIT=100
AI_MONTHLY_QUOTA_LIMIT=1000
AI_MAX_PROMPT_CHARS=8000
AI_GLOBAL_MONTHLY_COST_LIMIT_USD=50.0

# Document Upload & Vector Storage
UPLOAD_DIR=/app/uploads/documents
MAX_FILE_SIZE_BYTES=10485760
EMBEDDING_DIMENSION=1536

# Cloudinary Staging Storage
CLOUD_NAME=studymate-staging
CLOUD_API_KEY=staging-api-key
CLOUD_API_SECRET=staging-api-secret
CLOUD_FOLDER=studymate-staging

# Redis Staging Cache
REDIS_URL=redis://staging-redis.internal:6379

# Metrics Token for Prometheus / Datadog scraping
METRICS_AUTH_TOKEN=staging-metrics-bearer-token-secret
