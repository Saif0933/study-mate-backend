# ==============================================================================
# AI StudyMate - Production Environment Configuration Template
# Populate securely via AWS Secrets Manager, Vault, Render Secrets, or Fly Secrets.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

NODE_ENV=production
PORT=8080

# Production PostgreSQL with pgvector, SSL enforced, and bounded connection pool
DATABASE_URL=postgresql://prod_app_user:PROD_SECURE_PASSWORD_REPLACE@prod-pg-ha.internal:5432/studymate_production?sslmode=require&connection_limit=50&pool_timeout=15

# Production CORS origins (Mobile Flutter apps do not enforce origin headers, but web/admin portal does)
CORS_ORIGIN=https://app.studymate.ai,https://admin.studymate.ai

# Trust upstream load balancer / CDN (Cloudflare, AWS ALB, NGINX)
TRUST_PROXY=true

# Structured JSON logging for Datadog / CloudWatch / Grafana Loki
LOG_LEVEL=info
REQUEST_BODY_LIMIT=10mb

# Strong Production JWT secret (at least 64 random hex/base64 characters recommended)
JWT_SECRET=PROD_REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_HEX_KEY
JWT_EXPIRES_IN=7d

# OpenAI Production API credentials (isolated project key with strict budget alerts)
OPENAI_API_KEY=sk-proj-prod-placeholder-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI Tutor Parameter Tuning
AI_TUTOR_TEMPERATURE=0.7
AI_TUTOR_MAX_TOKENS=1024
AI_TUTOR_TIMEOUT_MS=30000
AI_TUTOR_MAX_RETRIES=2
AI_CONTEXT_MAX_MESSAGES=10

# AI Safety, Quotas & Cost Guardrails
AI_DAILY_QUOTA_LIMIT=50
AI_MONTHLY_QUOTA_LIMIT=500
AI_MAX_PROMPT_CHARS=8000
AI_GLOBAL_MONTHLY_COST_LIMIT_USD=250.0

# Document Upload & Vector Storage
UPLOAD_DIR=/app/uploads/documents
MAX_FILE_SIZE_BYTES=10485760
EMBEDDING_DIMENSION=1536

# Cloudinary / Private Object Storage for Encrypted Document Retention
CLOUD_NAME=studymate-production
CLOUD_API_KEY=PROD_CLOUD_API_KEY
CLOUD_API_SECRET=PROD_CLOUD_API_SECRET
CLOUD_FOLDER=studymate-production

# Redis & Asynchronous BullMQ Cluster
REDIS_URL=rediss://prod-redis-ha.internal:6379

# Operational Telemetry & Metrics Protection
# Required for scraping GET /health/metrics in production
METRICS_AUTH_TOKEN=PROD_REPLACE_WITH_SECURE_METRICS_BEARER_TOKEN
