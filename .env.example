# ==============================================================================
# AI StudyMate - Backend Environment Configuration Reference
# Use this as the master template for setting up local, staging, and production.
# NEVER commit real credentials, passwords, or API keys to version control.
# ==============================================================================

# Application Environment (development, test, staging, production)
NODE_ENV=development

# Server Listening Port (Cloud PaaS like Render, Fly.io, Cloud Run set this dynamically)
PORT=5000

# PostgreSQL Connection String (Prisma 7 with pg adapter & pgvector)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public&sslmode=prefer
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studymatedb

# CORS Allowed Origins
# Development: http://localhost:3000,http://localhost:5000,*
# Staging/Production: https://staging.studymate.ai,https://app.studymate.ai
CORS_ORIGIN=*

# Reverse Proxy Trust (Set to true when running behind NGINX, Cloudflare, AWS ALB, Render)
TRUST_PROXY=false

# Structured Logging Level (trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info

# Request Body Limit (Enforces max payload size to prevent DoS)
REQUEST_BODY_LIMIT=10mb

# JWT Secret (MUST be at least 32 characters in staging and production)
JWT_SECRET=development-fallback-secret-minimum-32-chars-long
JWT_EXPIRES_IN=7d

# OpenAI GPT & Embeddings API
OPENAI_API_KEY=sk-placeholder-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI Tutor Parameter Tuning
AI_TUTOR_TEMPERATURE=0.7
AI_TUTOR_MAX_TOKENS=1024
AI_TUTOR_TIMEOUT_MS=30000
AI_TUTOR_MAX_RETRIES=2
AI_CONTEXT_MAX_MESSAGES=10

# AI Safety, Quotas & Cost Guardrails
AI_DAILY_QUOTA_LIMIT=50
AI_MONTHLY_QUOTA_LIMIT=500
AI_MAX_PROMPT_CHARS=8000
AI_GLOBAL_MONTHLY_COST_LIMIT_USD=100.0

# Document Upload & Vector Storage
UPLOAD_DIR=uploads/documents
MAX_FILE_SIZE_BYTES=10485760
EMBEDDING_DIMENSION=1536

# Cloudinary / Private Object Storage (Optional for Phase 1-8; required if distributed)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
CLOUD_FOLDER=studymate-production

# Redis & Asynchronous BullMQ Processing (Optional if worker nodes are enabled)
REDIS_URL=redis://localhost:6379

# Operational Telemetry & Metrics Protection
# If set, GET /health/metrics requires Authorization: Bearer <METRICS_AUTH_TOKEN>
METRICS_AUTH_TOKEN=
